<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Everything else in this file is merged in at build time from
	     GENERATE_INFOPLIST_FILE = YES. Only keys that cannot be expressed as an
	     INFOPLIST_KEY_* build setting live here — CFBundleDocumentTypes is an
	     array of dictionaries, which that mechanism cannot express. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Markdown Document</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<!-- Measured on this machine: "public.markdown" does not exist; the
			     system-declared type for .md/.markdown is Daring Fireball's.
			     Do not "modernise" this to public.markdown without checking
			     UTType("public.markdown") first — it returns nil. -->
			<key>LSItemContentTypes</key>
			<array>
				<string>net.daringfireball.markdown</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Folder</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>None</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
